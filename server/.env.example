# Local development. Copy to server/.env (never committed) and adjust.
NODE_ENV=development
PORT=4000
DATABASE_URL="mysql://hqms_user:CHANGE_ME@127.0.0.1:3306/hqms"

COOKIE_SECURE=false
TRUST_PROXY=0
CORS_ORIGIN=
HOSPITAL_UTC_OFFSET_MINUTES=180
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
LOGIN_MAX_FAILED=5
LOCKOUT_MINUTES=15
LOGIN_RATE_LIMIT=30
PASSWORD_MIN_LENGTH=10
RESET_TOKEN_MINUTES=60
OUTBOX_POLL_MS=400
# If the database cannot be reached for this many checks in a row (one check per interval), the server exits so the platform restarts it. 0 turns this off.
DB_WATCHDOG_INTERVAL_MS=15000
DB_WATCHDOG_FAILURES=4
API_DOCS=true

# Only for networks that cannot download Prisma's engine binaries (see README). Leave unset normally.
# PRISMA_JS_ENGINE=1

# Optional, development only: synthetic demo accounts (one per department) created by `npm run db:seed`.
# SEED_DEMO_USERS=1
# DEMO_PASSWORD=CHANGE_ME_10_OR_MORE_CHARS

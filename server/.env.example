PORT=4000
ORG_NAME=AfriQueue
NODE_ENV=development

# First administrator account, created on first start if no admin exists.
# If ADMIN_PASSWORD is blank, a random one is generated and printed in the log.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# DATABASE_PATH=./data/queuems.db

# Africa's Talking SMS. Leave blank to log messages to the console instead.
# Use AT_USERNAME=sandbox with your sandbox API key for testing.
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
SMS_COUNTRY_CODE=254

# Text customers when this many people (or fewer) are ahead of them.
NOTIFY_AHEAD=3

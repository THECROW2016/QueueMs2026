# Copy to .env and replace every CHANGE_ME. NEVER commit the real .env file.
# Generate strong values with:  openssl rand -hex 24   (hex keeps the value URL-safe, which the database address needs)

# --- Database (used by docker compose) ---
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_PASSWORD=CHANGE_ME
MYSQL_DATABASE=hqms
MYSQL_USER=hqms

# --- Application ---
# Keep true in production. Browsers only send secure cookies over HTTPS (put the app behind HTTPS).
COOKIE_SECURE=true
# Number of reverse proxies in front of the app (1 when using the bundled Caddy proxy, 0 for direct access).
TRUST_PROXY=0
# Public address(es) users open in the browser, comma separated, if the web UI is served from a different origin. Usually empty.
CORS_ORIGIN=
# Minutes east of UTC for the hospital's local time (Nairobi = 180). Controls daily ticket numbering and report days.
HOSPITAL_UTC_OFFSET_MINUTES=180
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
# Interactive API docs at /api/docs. Leave false in production unless the site is on a private network.
API_DOCS=false
APP_PORT=4000

# --- HTTPS reverse proxy (docker compose --profile https) ---
HQMS_DOMAIN=queue.example.org

# Single-image deployment for platforms such as Railway (one app container + a managed MySQL).
# On every start it applies migrations, seeds reference data, optionally seeds synthetic test users, then runs the server.
FROM node:22-bookworm-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates tini && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
COPY server/package.json server/
COPY client/package.json client/
RUN npm ci
COPY . .
RUN npm run build -w client && npm run build -w server
WORKDIR /app/server
ENV NODE_ENV=production
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["sh", "-c", "npx prisma migrate deploy && NODE_ENV=development npx tsx prisma/seed.ts && ( [ -z \"$ADMIN_PASSWORD\" ] || node dist/cli/create-admin.js --username admin --name 'Test Administrator' ) && exec node dist/index.js"]
